{% extends 'layout/base.html.twig' %}

{% block title %}{{ view.key }} · Prozessgrafik · APRIL{% endblock %}

{% block head %}
    {# Both renderers are same-origin; process-graph is an optional production artifact. #}
    {{ importmap('template-graph') }}
{% endblock %}

{% block body %}
    {# 1. Kopfbereich #}
    <div class="card">
        <p class="crumbs">
            <a href="{{ path('app_templates_show', { key: view.key }) }}">← Zurück zur Template-Detailseite</a>
            &nbsp;·&nbsp;
            <a href="{{ path('app_templates_index') }}">Template-Liste</a>
        </p>
        <h1>Prozessgrafik – {{ view.key }}</h1>
        <p class="meta-line">Key: <code>{{ view.key }}</code></p>
        <p class="meta-line">Version: <strong>{{ view.version }}</strong></p>

        <p class="muted">Zeigt den Soll-Prozess des Templates: Schritte, Verzweigungen (Entscheidungen)
        und Parallelgruppen. Mit aktivierten Findings wird jeder Schritt zusätzlich nach seinem
        Prüfstatus eingefärbt.</p>

        {# Geschwister-Navigation, konsistent zur Template-Detailseite #}
        <div class="header-actions">
            <a class="pill-link" href="{{ path('app_templates_documents', { key: view.key }) }}">{{ 'glossary.items'|trans({}, 'glossary') }}</a>
            <a class="pill-link" href="{{ path('app_templates_access', { key: view.key }) }}">Access &amp; Visibility</a>
            <a class="pill-link" href="{{ path('app_templates_docs', { key: view.key }) }}">Dokumentation</a>
        </div>

        <div class="header-actions" aria-label="Renderer auswählen">
            <a class="pill-link {{ view.renderer == 'process-graph' ? 'is-active' : '' }}"
               href="{{ path('app_templates_graph', { key: view.key, withFindings: view.withFindings ? 1 : 0, renderer: 'process-graph', direction: view.direction }) }}">Process Graph</a>
            <a class="pill-link {{ view.renderer == 'mermaid' ? 'is-active' : '' }}"
               href="{{ path('app_templates_graph', { key: view.key, withFindings: view.withFindings ? 1 : 0, renderer: 'mermaid', direction: view.direction }) }}">Mermaid</a>
        </div>

        {# Layout-Ausrichtung des Process-Graph-Renderers (Mermaid bleibt top-down) #}
        <div class="header-actions" aria-label="Ausrichtung auswählen">
            <a class="pill-link {{ view.direction == 'LR' ? 'is-active' : '' }}"
               href="{{ path('app_templates_graph', { key: view.key, withFindings: view.withFindings ? 1 : 0, renderer: view.renderer, direction: 'LR' }) }}">⇢ Horizontal</a>
            <a class="pill-link {{ view.direction == 'TB' ? 'is-active' : '' }}"
               href="{{ path('app_templates_graph', { key: view.key, withFindings: view.withFindings ? 1 : 0, renderer: view.renderer, direction: 'TB' }) }}">⇣ Vertikal</a>
        </div>

        {# Findings an/aus – immer beide Richtungen anbieten #}
        <div class="header-actions">
            {% if view.withFindings %}
                <a class="pill-link is-active" href="{{ path('app_templates_graph', { key: view.key, withFindings: 1, renderer: view.renderer, direction: view.direction }) }}">Mit Findings</a>
                <a class="pill-link" href="{{ path('app_templates_graph', { key: view.key, renderer: view.renderer, direction: view.direction }) }}">Ohne Findings</a>
            {% else %}
                <a class="pill-link" href="{{ path('app_templates_graph', { key: view.key, withFindings: 1, renderer: view.renderer, direction: view.direction }) }}">Mit Findings</a>
                <a class="pill-link is-active" href="{{ path('app_templates_graph', { key: view.key, renderer: view.renderer, direction: view.direction }) }}">Ohne Findings</a>
            {% endif %}
        </div>

        {% if view.withFindings %}
            {% if view.limitReached %}
                <p class="muted">Findings on-demand berechnet (nicht persistiert) – aus Performance-Gründen
                nur für die ersten {{ view.findingsLimit }} von {{ view.totalDocuments }} Items.</p>
            {% else %}
                <p class="muted">Findings on-demand über {{ view.processedDocuments }} Item(s) berechnet (nicht persistiert).</p>
            {% endif %}
        {% else %}
            <p class="muted">Findings werden nicht automatisch berechnet, um die Ansicht performant zu halten.
            Alle Schritte sind daher grau (<em>nicht berechnet</em>). Über „Mit Findings" wird der Status je Schritt ermittelt.</p>
        {% endif %}
    </div>

    {# 2. Gerenderte Vorschau (lokal via AssetMapper/importmap, kein CDN) #}
    <div class="card">
        <h2>Gerenderte Vorschau</h2>
        <p class="muted">Process Graph ist der bevorzugte Renderer. Ist sein Artefakt nicht installiert
        oder schlägt die Darstellung kontrolliert fehl, wird automatisch Mermaid verwendet.</p>

        <div class="shape-legend">
            <span><span class="glyph">▭</span>Schritt (Farbe = Status)</span>
            <span><span class="glyph">◇</span>Entscheidung / Verzweigung</span>
            <span><span class="glyph">⬡</span>Parallelgruppe (Start / Zusammenführung)</span>
            <span><span class="glyph">◯</span>Start / Ende</span>
        </div>

        <div class="process-graph-preview"
             data-template-graph-target
             data-template-graph-renderer="{{ view.renderer }}"
             data-process-graph-direction="{{ view.direction }}"
             data-process-graph-module-url="{{ view.processGraphModuleUrl }}">
            <noscript>Die grafische Vorschau benötigt JavaScript. Graph-Modell und Mermaid-Quelltext bleiben verfügbar.</noscript>
        </div>
        <p class="muted process-graph-status" data-template-graph-status aria-live="polite"></p>
        <script type="application/json" data-process-graph-model>{{ view.processGraphJson|raw }}</script>
    </div>

    {# 3. Mermaid remains a visible fallback and export format. #}
    <div class="card">
        <h2>Mermaid-Quelltext</h2>
        <p class="muted">Der Quelltext kann unverändert in einen Mermaid-Renderer
        (z. B. mermaid.live oder eine Markdown-Vorschau) eingefügt werden.</p>

        <details class="mermaid-box" open>
            <summary>Mermaid-Quelltext anzeigen/ausblenden</summary>
            {# Read as plain text by template-graph.js; HTML-escaped, never injected as markup. #}
            <pre class="mermaid-source" data-mermaid-graph-source>{{ view.mermaidCode }}</pre>
        </details>
    </div>

    {# 4. Übergangs-/Entscheidungs-Findings: an Gateway/Kante zugeordnet #}
    {% if view.withFindings and view.hasTransitionDecisionFindings %}
        <div class="card">
            <h2>Übergangs-/Entscheidungs-Findings</h2>
            <p class="muted">Soll-/Ist-Abweichungen, die eindeutig einem Entscheidungs-Gateway
            oder einem beobachteten Übergang (Kante) zugeordnet werden konnten. Gateways mit
            solchen Findings sind in der Grafik eingefärbt; Kanten bleiben unverändert.</p>

            <table>
                <thead>
                    <tr>
                        <th>Zuordnung</th>
                        <th>Status</th>
                        <th>Kurztext</th>
                        <th>{{ 'glossary.items'|trans({}, 'glossary') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for finding in view.transitionDecisionFindings %}
                        <tr>
                            <td>{{ finding.targetLabel }}: <code>{{ finding.label }}</code></td>
                            <td><span class="status-badge gs-{{ finding.severity }}">{{ finding.severityLabel }}</span></td>
                            <td>{{ finding.message }}</td>
                            <td>
                                {% if finding.hasDocuments %}
                                    {% if finding.isGateway %}
                                        <a class="pill-link" href="{{ path('app_templates_documents', { key: view.key, withFindings: 1, decision: finding.decisionKey }) }}">{{ finding.documentCount }} – Items anzeigen</a>
                                    {% else %}
                                        <a class="pill-link" href="{{ path('app_templates_documents', { key: view.key, withFindings: 1, transitionFrom: finding.transitionFrom, transitionTo: finding.transitionTo }) }}">{{ finding.documentCount }} – Items anzeigen</a>
                                    {% endif %}
                                {% else %}
                                    <span class="muted">{{ finding.documentCount }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {# 5. Legende, prozessweite Findings und Schritt-Tabelle (barrierearmer Fallback) #}
    <div class="card">
        <h2>Schritte &amp; Status</h2>
        <p class="muted">Die Farbe entspricht der Einfärbung des jeweiligen Schritts in der Grafik.
        Strukturknoten (Start/Ende, Entscheidungen, Parallelgruppen) tragen keine Findings.</p>

        <div class="legend">
            <span class="legend-title">Schritt-Status:</span>
            {% for item in view.legend %}
                <span class="status-badge gs-{{ item.status }}">{{ item.label }}</span>
            {% endfor %}
            <span class="status-badge gs-structure">Struktur</span>
        </div>

        {% if view.withFindings %}
            {% if view.hasProcessFindings %}
                <p class="meta-line">Nicht zuordenbare prozessweite Findings (weder Schritt, Gateway noch Kante):
                    {{ view.processDeviations }} Abweichung(en) ·
                    {{ view.processWarnings }} Warnung(en) ·
                    {{ view.processTechnical }} technisch</p>
            {% else %}
                <p class="meta-line muted">Keine nicht zuordenbaren prozessweiten Findings festgestellt.</p>
            {% endif %}
        {% endif %}

        <table>
            <thead>
                <tr>
                    <th>Schritt</th>
                    <th>Status</th>
                    <th>Findings (Zusammenfassung)</th>
                    <th>{{ 'glossary.items'|trans({}, 'glossary') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for step in view.steps %}
                    <tr>
                        <td>{{ step.name }}{% if is_expert_view() %} <code class="muted">{{ step.key }}</code>{% endif %}</td>
                        <td><span class="status-badge gs-{{ step.status }}">{{ step.statusLabel }}</span></td>
                        <td>{{ step.findingsLabel }}</td>
                        <td>
                            {% if step.hasFindings %}
                                <a class="pill-link" href="{{ path('app_templates_documents', { key: view.key, withFindings: 1, step: step.key }) }}">Items anzeigen</a>
                            {% else %}
                                <span class="muted">—</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
